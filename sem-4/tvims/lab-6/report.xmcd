		<region region-id="3968" left="804" top="1698.75" width="234" height="28.5" align-x="804" align-y="1710" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">табличное значение</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">(квантиль распределения Стьюдента)</p>
			</text>
		</region>
		<region region-id="3969" left="576" top="1696.5" width="210" height="33.75" align-x="611.25" align-y="1716" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">t_tabl</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:id xml:space="preserve">qt</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:minus/>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">α</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:id xml:space="preserve">k</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:parens>
								</ml:apply>
							</ml:sequence>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>2.2621571627982018</ml:real>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="29"/>
		</region>
		<region region-id="3970" left="576" top="1764.75" width="309.75" height="76.5" align-x="576" align-y="1776" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Вывод:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">b<sub>0 </sub>значимо отличается от 0, т.к. |<region region-id="4035" left="740.25" top="1779.75" width="9.75" height="17.25" align-x="744" align-y="1791" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
								<ml:indexer/>
								<ml:id xml:space="preserve">t</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
						</math>
						<rendering item-idref="30"/>
					</region>
					<f family="Times New Roman" charset="0" size="12">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">| = 2.263 &gt; t_tabl = 2.262<sp count="2"/>
						</inlineAttr>
					</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">b<sub>1</sub>
					<sub>
						<sp/>
					</sub>значимо отличается от 0, т.к. |<region region-id="4038" left="740.25" top="1802.25" width="9.75" height="17.25" align-x="744" align-y="1813.5" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
								<ml:indexer/>
								<ml:id xml:space="preserve">t</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
						</math>
						<rendering item-idref="31"/>
					</region>
					<f family="Times New Roman" charset="0" size="12">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">| </inlineAttr>
					</f>= 4.673 &gt; t_tabl = 2.262</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Times New Roman" charset="0" size="12">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">b</inlineAttr>
					</f>
					<sub>
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">
							<f family="Times New Roman" charset="0" size="12">2 </f>
						</inlineAttr>
					</sub>
					<f family="Times New Roman" charset="0" size="12">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">НЕ значимо отличается от 0</inlineAttr>
					</f>, т.к. |t<sub>2</sub>| = 1.142 &lt; t_tabl = 2.262</p>
			</text>
		</region>
		<region region-id="3971" left="576" top="1878.75" width="456" height="14.25" align-x="576" align-y="1890" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Построение доверительных интервалов для коэффициентов регрессионной модели</b>
				</p>
			</text>
		</region>
		<region region-id="4811" left="918" top="1908.75" width="154.5" height="31.5" align-x="918" align-y="1920" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">

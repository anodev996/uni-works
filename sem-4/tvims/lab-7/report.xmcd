	<regions>
		<region region-id="5223" left="558" top="12.75" width="469.5" height="42.75" align-x="558" align-y="24" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Лаб. работа #7, Вариант 9.</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit"/>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">424-1, Бадулин Илья, Ушаков Максим.</p>
			</text>
		</region>
		<region region-id="8585" left="1110" top="84" width="492.75" height="272.25" align-x="1110" align-y="84" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<picture>
				<png item-idref="2" display-width="491.25" display-height="270.75"/>
			</picture>
			<rendering item-idref="3"/>
		</region>
		<region region-id="5273" left="558" top="78.75" width="50.25" height="14.25" align-x="578.25" align-y="90" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Задание 1</p>
			</text>
		</region>
		<region region-id="5225" left="558" top="108.75" width="520.5" height="156.75" align-x="558" align-y="120" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<b>Описание ситуации с помощью цепи Маркова и обоснование модели:</b>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit"/>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<inlineAttr font-weight="normal" font-style="normal">Ситуация: Происходит случайное блуждание частицы по точкам A1=1, A2=2, A3=3, A4=4. Точки A1 и A4 являются отражающими экранами (из A1 частица гарантированно переходит в A2, а из A4 - в A3). Из внутренних точек (A2, A3) частица переходит вправо с вероятностью 0,4 и влево с вероятностью 0,6.</inlineAttr>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit"/>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<inlineAttr font-weight="normal" font-style="normal">Цепь Маркова: Данная система является цепью Маркова, так как:</inlineAttr>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<inlineAttr font-weight="normal" font-style="normal">- Вершины A1, A2, A3, A4 представляют собой конечное множество состояний.</inlineAttr>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<inlineAttr font-weight="normal" font-style="normal">- Вероятность перехода в следующее состояние зависит только от текущего положения частицы и не зависит от ее предыдущей истории</inlineAttr>
				</p>
			</text>
		</region>
		<region region-id="5226" left="558" top="294.75" width="93.75" height="14.25" align-x="576" align-y="306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Матрица перехода</p>
			</text>
		</region>
		<region region-id="5227" left="558" top="335.25" width="127.5" height="78.75" align-x="573.75" align-y="378" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">P</ml:id>
					<ml:matrix rows="4" cols="4">
						<ml:real>0</ml:real>
						<ml:real>0.6</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0</ml:real>
						<ml:real>1</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0.6</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0.4</ml:real>
						<ml:real>0</ml:real>
						<ml:real>1</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0</ml:real>
						<ml:real>0.4</ml:real>
						<ml:real>0</ml:real>
					</ml:matrix>
				</ml:define>
			</math>
			<rendering item-idref="4"/>
		</region>
		<region region-id="5228" left="642" top="456.75" width="38.25" height="15.75" align-x="660" align-y="468" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">

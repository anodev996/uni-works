					<parentRef doc-id="7C72BE96-4C1F-4C52-AEA9-5BEE5FDF0668" version-id="AA89BC3A-D48D-4592-8A8C-2ACD7F4A4348" branch-id="00000000-0000-0000-0000-000000000000" revision-num="397590732" is-modified="false" region-id="0" href="D:\desktop-bubsage\220-tusur\uni-works\sem-4\tvims\lab-7\reference\ТВИМС - Лаб7 - 1.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">

            GL.Vertex2(0.0f, 0.0f);

            GL.Vertex2(0.0f, 0.0f);
            GL.Vertex2(0.40f, -0.175f);

            GL.Vertex2(0.40f, -0.175f);
            GL.Vertex2(-0.35f, -0.55f);

            GL.End();

            GL.PointSize(9.0f);
            GL.Begin(PrimitiveType.Points);
            GL.Vertex2(-0.35f, 0.55f);
            GL.Vertex2(-0.35f, -0.55f);
            GL.Vertex2(0.0f, 0.375f);
